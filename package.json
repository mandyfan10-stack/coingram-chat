{
  "name": "coingram-chat",
  "private": true,
  "version": "1.20.13",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node testE2EE.js && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "release:verify": "node scripts/verify-release-version.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "clean:all": "node scripts/clean-artifacts.mjs --all",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "node scripts/deploy-pages.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@supabase/supabase-js": "2.110.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.coingram.chat",
    "productName": "Coiny",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Coiny"
    }
  }
}
